RewriteEngine On
RewriteBase /

# Do not rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Block SPA fallback for API, admin, and all backend directories
RewriteCond %{REQUEST_URI} ^/(api|admin|pay|pg|jili|assets|images|images_usdt|vendors|uploads|database|selfservice|tashangame|Tashanveu|jdb|jdbapi|jet|plugins|serive|manifest)/ [NC]
RewriteRule ^ - [L]

# Block SPA fallback for PHP files
RewriteCond %{REQUEST_URI} \.php$ [NC]
RewriteRule ^ - [L]

# SPA fallback ONLY for everything else
RewriteRule ^.*$ /index.html [L]

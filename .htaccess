RewriteEngine On
RewriteBase /

# Do not rewrite existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Hide .php extension (optional)
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Exclude known public folders from SPA fallback
RewriteCond %{REQUEST_URI} !^/(api|admin|pay|pg|jili|assets|images|images_usdt|vendors|uploads|favicon|logo)/? [NC]
RewriteRule ^.*$ /index.html [L]

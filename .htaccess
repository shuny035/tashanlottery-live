RewriteEngine On
RewriteBase /

# Allow direct file access if file exists
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Check if php file exists without .php extension
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)$ $1.php [L]

# Admin fallback
RewriteRule ^admin/?$ admin/index.php [L]

# Frontend fallback (SPA)
RewriteCond %{REQUEST_URI} !^/(api|admin|pay)/
RewriteRule ^.*$ index.html [L]
